# Server settings (environment variables). Copy what you need into your environment or
# your process manager's config; the server does not read this file itself.

# Required.
DATABASE_URL=postgres://pokerladder:pokerladder@localhost:55432/pokerladder

# Where to listen. Behind a reverse proxy, keep it on localhost.
BIND_ADDR=127.0.0.1:8080

# The site's origin exactly as browsers see it (no path). Used for email links and to
# reject WebSocket connections from other sites. https => cookies are marked Secure.
PUBLIC_URL=http://localhost:8080

# Email. Required when PUBLIC_URL is https; without it emails are only logged.
# smtps:// = implicit TLS (port 465); smtp://...?tls=required = STARTTLS (port 587).
# SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
# MAIL_FROM=Pokerladder <noreply@pokerladder.example>

# Only verified accounts may queue (default true).
# REQUIRE_EMAIL_VERIFICATION=true

# The built web client (default: web/dist if it exists).
# STATIC_DIR=/srv/pokerladder/web

# Behind a reverse proxy that always sets it, the header carrying the client IP (used
# for rate limiting). Leave unset when clients connect directly.
# TRUSTED_PROXY_HEADER=X-Forwarded-For

# Log filter.
# RUST_LOG=info,sqlx=warn
