[Unit]
Description=Pokerladder game server
Requires=pokerladder-db.service
After=pokerladder-db.service

[Service]
EnvironmentFile=%h/.config/pokerladder/pokerladder.env
WorkingDirectory=%h/Projects/pokerladder
ExecStart=%h/Projects/pokerladder/target/release/pokerladder-server
# On SIGINT or SIGTERM the server stops starting matches and waits for those in
# progress (up to DRAIN_TIMEOUT_SECS, default 45 min) before exiting, so a stop or
# restart can take that long. `systemctl --user kill -s INT pokerladder` a second
# time stops it at once (unfinished matches are then abandoned, unrated).
KillSignal=SIGINT
TimeoutStopSec=50min
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
